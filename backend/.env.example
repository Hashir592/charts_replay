# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in your values for local development.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
# Local development port. In production, Render injects PORT automatically.
PORT=8000

# Bind address — keep 0.0.0.0 so Docker / WSL can reach the server too.
HOST=0.0.0.0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Use "*" to allow all (handy during local dev).
# In production set to your Vercel URL, e.g.:
#   FRONTEND_URL=https://my-tradingview-clone.vercel.app
FRONTEND_URL=*

# ── Cache ─────────────────────────────────────────────────────────────────────
# How long (in seconds) to cache yfinance responses in memory.
# Default: 300 (5 minutes). Increase to reduce Yahoo Finance round-trips.
CACHE_TTL_SECONDS=300

# ── App environment tag ───────────────────────────────────────────────────────
# Reflected in startup logs. One of: development | staging | production
ENVIRONMENT=development
